# StreamBox backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas) connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net

# JWT signing secret (use a strong random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# YouTube Data API v3 key (used to sync the catalog)
YOUTUBE_API_KEY=your_youtube_api_key

# CORS: which origin(s) may call the API. Comma-separated for multiple.
# Dev default below; after deployment set this to your production frontend URL.
CORS_ORIGIN=http://localhost:3000

# Content sync schedule (cron) and timezone
SYNC_CRON=0 3 * * *
SYNC_TIMEZONE=Africa/Douala

# Premium expiry check schedule (cron) - default hourly
EXPIRY_CRON=0 * * * *

# CamPay Mobile Money (MTN & Orange Cameroon)
# MOCK mode simulates collect + success so the whole flow can be tested offline.
CAMPAY_MODE=mock
# To take REAL payments, fill these in and set CAMPAY_ENVIRONMENT:
#   CAMPAY_MODE=live
#   CAMPAY_APP_USERNAME=your_campay_app_username
#   CAMPAY_APP_PASSWORD=your_campay_app_password
#   CAMPAY_ENVIRONMENT=DEV   (CamPay test environment)
#   CAMPAY_ENVIRONMENT=PROD  (live money - only switch when ready)
